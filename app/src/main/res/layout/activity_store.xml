<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="afterDescendants"
    android:fitsSystemWindows="true"
    android:background="#000000">

    <!-- Google Play Store Search Bar Header (Full width, transparent background with border) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_store_search_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <ImageView
            android:id="@+id/store_back_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            app:tint="#E3E3E3" />

        <EditText
            android:id="@+id/store_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:background="@null"
            android:hint="@string/store_search_hint"
            android:textColor="#FFFFFF"
            android:textColorHint="#9AA0A6"
            android:textCursorDrawable="@null"
            android:textColorHighlight="#33FFFFFF"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:inputType="text" />

        <ImageView
            android:id="@+id/store_search_clear"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:src="@drawable/ic_clear"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Borrar búsqueda"
            android:visibility="gone"
            app:tint="#9AA0A6" />
    </LinearLayout>

    <!-- Subtitle / Categories Header (Google Play Style Chips) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_for_you"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="@drawable/bg_store_chip_unselected"
                android:text="All"
                android:textColor="#9AA0A6"
                android:textSize="13sp"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false" />

            <TextView
                android:id="@+id/chip_system"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="@drawable/bg_store_chip_unselected"
                android:text="System"
                android:textColor="#9AA0A6"
                android:textSize="13sp"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false" />

            <TextView
                android:id="@+id/chip_top_tools"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="@drawable/bg_store_chip_unselected"
                android:text="Tools"
                android:textColor="#9AA0A6"
                android:textSize="13sp"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false" />

            <TextView
                android:id="@+id/chip_dev"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="@drawable/bg_store_chip_unselected"
                android:text="Dev"
                android:textColor="#9AA0A6"
                android:textSize="13sp"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false" />

            <TextView
                android:id="@+id/chip_google"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="@drawable/bg_store_chip_unselected"
                android:text="Google"
                android:textColor="#9AA0A6"
                android:textSize="13sp"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false" />

            <TextView
                android:id="@+id/chip_ai_cli"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="@drawable/bg_store_chip_unselected"
                android:text="Ai &amp; cli"
                android:textColor="#9AA0A6"
                android:textSize="13sp"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- List of Packages (Play Store App Feed) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/store_packages_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="16dp" />

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/store_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="32dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_search"
            app:tint="#5F6368" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No se encontraron paquetes"
            android:textColor="#E3E3E3"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Prueba con otro término de búsqueda o categoría."
            android:textColor="#9AA0A6"
            android:textSize="12sp"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
